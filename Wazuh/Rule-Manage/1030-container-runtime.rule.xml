<!-- =====================================================================
       SECTION 1: Container Runtime Execution (key="runtime_execution")
       ===================================================================== -->
<group name="docker,">
    
  <!-- Parent Rule: ดักจับการกระทำเกี่ยวกับ Container ทั้งหมด (ทั้ง CLI และ Socket) -->
  <rule id="103000" level="0">
    <if_sid>80700</if_sid>
    <!-- ปรับให้รับทั้ง 2 Key โดยใช้ ( | ) -->
    <field name="audit.key" type="pcre2">^(runtime_execution|runtime_socket)$</field>
    <description>🔇Container Security: Runtime CLI and Socket parent rule.</description>
  </rule>

  <!-- Level 12: ดักจับคำสั่ง "exec" (T1609 - Lateral Movement) -->
  <rule id="103001" level="12">
    <if_sid>103000</if_sid>
    <field name="audit.execve.a1" type="pcre2">^exec$</field>
    <description>🚨Container Security: Docker 'exec' command used (Possible lateral movement).</description>
    <mitre><id>T1609</id></mitre>
    <group>runtime_exec, soc_alert,</group>
  </rule>

  <!-- Level 10: ดักจับคำสั่งจัดการ Image ที่มีความเสี่ยง (commit, export, save) -->
  <rule id="103002" level="12">
    <if_sid>103000</if_sid>
    <field name="audit.execve.a1" type="pcre2">^(commit|export|save)$</field>
    <description>🚨Container Security: Docker image commit|export|save </description>
    <mitre><id>T1525</id><id>T1048</id></mitre>
    <group>runtime_image, soc_alert,</group>
  </rule>

  <!-- Level 8: ดักจับคำสั่ง "cp" (T1039 - Data copying) -->
  <rule id="103003" level="8">
    <if_sid>103000</if_sid>
    <field name="audit.execve.a1" type="pcre2">^cp$</field>
    <description>🚨Container Security: Docker 'cp' command used (Data copying in/out of container).</description>
    <mitre><id>T1039</id></mitre>
    <group>runtime_cp,</group>
  </rule>

  <!-- Level 5: ดักจับคำสั่ง "run" (T1610 - New container execution) -->
  <rule id="103004" level="5">
    <if_sid>103000</if_sid>
    <field name="audit.execve.a1" type="pcre2">^run$</field>
    <description>⚠️Container Security: Docker 'run' command used (New container execution).</description>
    <mitre><id>T1610</id></mitre>
    <group>runtime_run,</group>
  </rule>

  <!-- Level 4: ดักจับคำสั่งจัดการ Image ทั่วไป (pull, build) -->
  <rule id="103005" level="4">
    <if_sid>103000</if_sid>
    <field name="audit.execve.a1" type="pcre2">^(pull|build)$</field>
    <description>⚠️Container Security: Docker 'pull' or 'build' command used.</description>
    <group>runtime_build,</group>
  </rule>
<!-- Level 12: ดักจับการแทรกแซง Docker Socket (T1609 / T1068) -->
  <rule id="103006" level="14">
    <if_sid>103000</if_sid>
    <!-- จับ Key ให้ตรงกับที่คุณตั้งไว้ -->
    <field name="audit.key" type="pcre2">runtime_socket</field>
    <description>🚨 Container Security: Docker Socket tampering/access detected (Possible Container Escape attempt).</description>
    <mitre><id>T1609</id><id>T1068</id></mitre>
    <group>runtime_socket, soc_alert,</group>
  </rule>
  <!-- ดักจับ Container Escape ผ่าน CLI (จับข้อ 4 โดยเฉพาะ) -->
  <rule id="103007" level="14">
    <if_sid>103004</if_sid> <!-- ดึงมาจาก Rule docker run (103004) -->
    <match>docker.sock</match> <!-- ค้นหาคำนี้ในคำสั่ง -->
    <description>🚨 Container Security: Attempt to mount Docker Socket via CLI (Container Escape).</description>
    <mitre><id>T1609</id><id>T1068</id></mitre>
    <group>runtime_socket, soc_alert,</group>
  </rule>
  
  <!-- Rule 103008: รับลูกจาก Falco Tag (soar_kick) เพื่อสั่งเตะแฮกเกอร์ -->
  <rule id="103008" level="14">
    <decoded_as>json</decoded_as>
    <match>soar_kick</match>
    <description>🚨 eBPF/SOAR: Critical threat detected by Falco! Triggering active defense (Tool: $(output_fields.proc.name)).</description>
    <mitre><id>T1609</id></mitre>
    <group>ebpf_alert, soc_alert,</group>
  </rule>
  
  
 
  <!-- Rule 103009: กฎพื้นฐาน รับ Log ทุกอย่างจาก Tetragon ที่มีการระบุ Policy -->
  <rule id="103009" level="3" >
    <decoded_as>json</decoded_as>
    <field name="process_kprobe.policy_name">\.+</field>
    <description>🛡️ Tetragon (eBPF): System event detected by policy [$(process_kprobe.policy_name)]</description>
    <group>ebpf_alert, soc_alert,</group>
  </rule>

  <!-- Rule   ดักจับและแจ้งเตือนขั้นสุดยอด เมื่อ Tetragon สับกิโยติน (SIGKILL) -->
 
 
 <!-- 🛡️ กติกาหลัก (ตัวแสดงผล) -->
 <!-- Rule   ดักจับและแจ้งเตือนขั้นสุดยอด เมื่อ Tetragon สับกิโยติน (SIGKILL) -->
  <rule id="103010" level="12">
    <if_sid>103009</if_sid>
    <field name="process_kprobe.action">KPROBE_ACTION_SIGKILL</field>
    <description>🪓 Tetragon eBPF Enforcement: Process blocked and killed by policy [$(process_kprobe.policy_name)]</description>
    <mitre><id>T1059</id></mitre>
    <group>ebpf_alert, soc_alert, blocked_process, zero_trust_prevention,</group>
  </rule>

  
</group>
